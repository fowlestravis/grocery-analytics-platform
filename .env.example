# Grocery Warehouse (PostgreSQL)
GROCERY_DB_HOST=localhost
GROCERY_DB_PORT=5432
GROCERY_DB_NAME=grocery_analytics
GROCERY_DB_USER=your_db_user
GROCERY_DB_PASSWORD=your_db_password

# Metabase
METABASE_URL=http://localhost:3000
METABASE_EMAIL=your_metabase_email
METABASE_PASSWORD=your_metabase_password

# Airflow Metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=your_airflow_db_password
AIRFLOW_DB_NAME=airflow

# Airflow Web UI
AIRFLOW_WWW_USER=airflow
AIRFLOW_WWW_PASSWORD=your_airflow_password
